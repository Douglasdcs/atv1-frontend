// prisma/schema.prisma

// Configuração do gerador - isso cria o Prisma Client
generator client {
  provider = "prisma-client-js"
}

// Configuração da fonte de dados - de onde vêm os dados
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Lê do arquivo .env
}

// Tabela de produtos
model TrabalhoRelacionado {
  id       Int      @id @default(autoincrement())
  title    String   @db.VarChar(255)
  doi      String   @db.VarChar(255)
  resumo   String   @db.Text
  autor    String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("trabalhos_relacionados")
}


